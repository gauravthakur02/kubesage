{
  "name": "kubeweave",
  "displayName": "kubeweave",
  "description": "Open kubeweave, the Kubernetes IDE for your terminal, inside VS Code",
  "version": "0.1.0",
  "publisher": "gauravthakur02",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/gauravthakur02/kubeweave" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["kubernetes", "k8s", "kubectl", "tui", "ai"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "kubeweave.open", "title": "kubeweave: Open" },
      { "command": "kubeweave.openContext", "title": "kubeweave: Open cluster…" },
      { "command": "kubeweave.openReadOnly", "title": "kubeweave: Open read-only" },
      { "command": "kubeweave.applyFile", "title": "kubeweave: Diff and apply this manifest" },
      { "command": "kubeweave.devFolder", "title": "kubeweave: Dev loop on this folder" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "kubeweave.applyFile", "when": "resourceExtname =~ /\\.ya?ml$/", "group": "kubeweave" },
        { "command": "kubeweave.devFolder", "when": "explorerResourceIsFolder", "group": "kubeweave" }
      ],
      "editor/title/context": [
        { "command": "kubeweave.applyFile", "when": "resourceExtname =~ /\\.ya?ml$/", "group": "kubeweave" }
      ]
    },
    "keybindings": [
      { "command": "kubeweave.open", "key": "ctrl+alt+k", "mac": "cmd+alt+k" }
    ],
    "configuration": {
      "title": "kubeweave",
      "properties": {
        "kubeweave.path": { "type": "string", "default": "kubeweave", "description": "Path to the kubeweave binary." },
        "kubeweave.readOnly": { "type": "boolean", "default": false, "description": "Always start with --readonly." },
        "kubeweave.extraArgs": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Extra arguments, e.g. [\"-n\", \"shop\"]." }
      }
    }
  }
}
